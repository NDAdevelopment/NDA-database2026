{
  "name": "Dental Exam Library",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance"],
      "openFiles": ["db7559__12_pdf.py"]
    }
  },
  "postCreateCommand": "pip install -r requirements.txt",
  "postAttachCommand": "streamlit run db7559__12_pdf.py --server.enableCORS false --server.enableXsrfProtection false",
  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": {
      "label": "Application",
      "onAutoForward": "openPreview"
    }
  }
}